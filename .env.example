# =============================================================================
# SCG — variables d'environnement
# Copiez ce fichier vers .env.local et renseignez-le. .env.local n'est jamais
# committé. En production, ces valeurs vivent dans l'unité systemd, pas dans
# un fichier de la racine web.
# =============================================================================

# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://scg:motdepasse@localhost:5432/scg"
DATABASE_POOL_MAX="10"

# --- Application -------------------------------------------------------------
# Utilisée pour les liens absolus dans les e-mails et les redirections OAuth.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Comptes (étape 3) -------------------------------------------------------
# Générer avec : node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Paiement Mobile Money (étape 3) -----------------------------------------
# FedaPay ou KKiaPay. La clé publique part au navigateur, la privée reste ici.
PAIEMENT_FOURNISSEUR="fedapay"
NEXT_PUBLIC_PAIEMENT_CLE_PUBLIQUE=""
PAIEMENT_CLE_PRIVEE=""
PAIEMENT_WEBHOOK_SECRET=""

# --- Fichiers, hors racine web (étape 4) -------------------------------------
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="scg"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- E-mail (étape 3) --------------------------------------------------------
# Depuis le domaine SCG, avec SPF/DKIM/DMARC — jamais depuis un Gmail perso.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_EXPEDITEUR="SCG <contact@example.bj>"
